# Nomor WhatsApp penerima konsultasi.
# Gunakan format internasional. Contoh: 6281234567890 atau +62 812-3456-7890.
# Biarkan kosong selama nomor belum tersedia; semua CTA akan memakai email fallback.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL publik situs, tanpa trailing slash.
# Biarkan kosong untuk pengembangan lokal. Isi saat deploy agar canonical,
# Open Graph URL, robots, dan sitemap memakai domain yang benar.
# Contoh: https://namadomain.id
NEXT_PUBLIC_SITE_URL=
